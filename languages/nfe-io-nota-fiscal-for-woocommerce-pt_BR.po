#. Plugin Name of the plugin
#: nota-fiscal-nfe-io-for-woocommerce.php
#: includes/admin/views/html-notice-legacy-plugin.php:34
msgid "Nota Fiscal NFe.io for WooCommerce"
msgstr "Nota Fiscal NFe.io for WooCommerce"

#. Plugin URI of the plugin
#: nota-fiscal-nfe-io-for-woocommerce.php
msgid "https://github.com/nfe/woo-nfe"
msgstr "https://github.com/nfe/woo-nfe"

#. Description of the plugin
#: nota-fiscal-nfe-io-for-woocommerce.php
msgid ""
"Issue Brazilian service invoices (NFS-e) from WooCommerce orders through the "
"NFe.io API."
msgstr "Emita notas fiscais de serviço (NFS-e) a partir dos pedidos do WooCommerce, pela API da NFe.io."

#. Author of the plugin
#: nota-fiscal-nfe-io-for-woocommerce.php
msgid "NFe.io"
msgstr "NFe.io"

#. Author URI of the plugin
#: nota-fiscal-nfe-io-for-woocommerce.php
msgid "https://nfe.io"
msgstr "https://nfe.io"

#. translators: 1: Order ID, 2: current NFe status.
#: includes/admin/class-nfe-woo.php:214
#, php-format
msgid ""
"Skipping a second issuing attempt for order #%1$d: an invoice is already "
"%2$s."
msgstr "Segunda tentativa de emissão ignorada para o pedido #%1$d: já existe uma nota %2$s."

#. translators: 1: externalId, 2: error message.
#: includes/admin/class-nfe-woo.php:360
#, php-format
msgid "Could not check whether externalId %1$s produced an invoice: %2$s"
msgstr "Não foi possível verificar se o externalId %1$s gerou uma nota: %2$s"

#: includes/admin/class-nfe-woo.php:398
msgid ""
"NFe could not be issued: the NFe.io API key was rejected. Check the API key "
"in the plugin settings."
msgstr "A NFe não pôde ser emitida: a chave de API da NFe.io foi recusada. Confira a chave nas configurações do plugin."

#. translators: %s: error message returned by the API.
#: includes/admin/class-nfe-woo.php:411
#, php-format
msgid ""
"The NFe issuing call failed (%s) and it could not be confirmed whether an "
"invoice was created. This order was left marked as in progress on purpose, "
"to avoid issuing a duplicate. Check the invoice in the NFe.io panel, then re-"
"issue only if none exists."
msgstr "A chamada de emissão da NFe falhou (%s) e não foi possível confirmar se a nota chegou a ser criada. Este pedido foi mantido como em andamento de propósito, para evitar uma nota duplicada. Verifique no painel da NFe.io e só reemita se não existir nenhuma."

#. translators: %s: error message returned by the API.
#: includes/admin/class-nfe-woo.php:426
#, php-format
msgid ""
"The NFe issuing call failed (%s), but the invoice had already been created "
"and was recovered. No second invoice was issued."
msgstr "A chamada de emissão da NFe falhou (%s), mas a nota já havia sido criada e foi recuperada. Nenhuma segunda nota foi emitida."

#. translators: %s: error message returned by the API.
#: includes/admin/class-nfe-woo.php:435
#, php-format
msgid "An error occurred while issuing a NFe: %s"
msgstr "Ocorreu um erro ao emitir uma nota fiscal: %s"

#. translators: Log message.
